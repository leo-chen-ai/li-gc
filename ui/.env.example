# Required environment variables
# These MUST be set or the app will not start

# Backend API URL
VITE_API_URL=http://localhost:8080

# 高德开放平台「Web端(JS API)」类型的 Key 及配套安全密钥
# 用于项目表单的地图定位选点及后续数据大屏地图展示
# VITE_AMAP_KEY=your_amap_jsapi_key
# VITE_AMAP_SECURITY_CODE=your_amap_security_code

# 百度地图浏览器端 AK（数据大屏底图：陆地近黑 / 水域 #00364B）
# 注意：ui/.env、.env.deploy 可能被协同覆盖；源码 ui/src/lib/baidu-map.ts 与
# deploy/k3s/deploy-local.sh 内已有同值兜底，线上构建不依赖本地 env 一定存在。
# VITE_BAIDU_MAP_AK=your_baidu_browser_ak

# Add more environment variables here as needed:
# VITE_SUI_NETWORK=testnet
# VITE_CONTRACT_ADDRESS=0x...
