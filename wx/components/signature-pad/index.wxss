.signature-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.55);
}

.signature-panel {
  width: 100%;
  border-radius: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.signature-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.signature-heading {
  min-width: 0;
}

.signature-title {
  color: #203033;
  font-size: 32rpx;
  font-weight: 800;
}

.signature-subtitle {
  margin-top: 8rpx;
  color: #7d8b90;
  font-size: 23rpx;
}

.signature-close {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: #5c6b70;
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
  background: #f1f5f6;
}

.signature-canvas {
  width: 100%;
  height: 520rpx;
  margin-top: 22rpx;
  border: 1rpx solid #dce6e8;
  border-radius: 16rpx;
  background: #ffffff;
}

.signature-tip {
  margin-top: 14rpx;
  color: #d93026;
  font-size: 24rpx;
}

.signature-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.signature-ghost {
  flex: 1;
  height: 76rpx;
  border: 1rpx solid #dce6e8;
  border-radius: 16rpx;
  color: #435156;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
  background: #ffffff;
}

.signature-primary {
  flex: 1.4;
  height: 76rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
  background: #0a9875;
}

.signature-primary.disabled {
  opacity: 0.6;
}
