<view class="attendance-page">
  <view class="page-top">
    <view class="back-button" bind:tap="goBack">‹</view>
    <view class="page-title">出勤统计</view>
    <view class="top-spacer"></view>
  </view>

  <view class="project-strip">
    <image class="project-bg" src="{{pageHeaderBg}}" mode="aspectFill" />
    <view class="project-label">项目名称</view>
    <view class="project-name">{{projectName}}</view>
  </view>

  <view class="stats-card">
    <view class="month-title">{{month}}⌄</view>
    <view class="stats-grid">
      <view><view class="stat-value">{{stats.total}}</view><view class="stat-label">总人数</view></view>
      <view><view class="stat-value present">{{stats.present}}</view><view class="stat-label">出勤</view></view>
      <view><view class="stat-value absent">{{stats.absent}}</view><view class="stat-label">缺勤</view></view>
      <view><view class="stat-value rate">{{stats.rate}}</view><view class="stat-label">出勤率</view></view>
    </view>
  </view>

  <view class="filter-card">
    <view class="filter-grid">
      <picker range="{{teamOptions}}" value="{{teamIndex}}" bindchange="onTeamFilterChange">
        <view class="filter-pill">{{teamFilter}}⌄</view>
      </picker>
      <picker range="{{companyOptions}}" value="{{companyIndex}}" bindchange="onCompanyFilterChange">
        <view class="filter-pill">{{companyFilter}}⌄</view>
      </picker>
    </view>
    <view class="search-row">
      <input class="search-input" value="{{keyword}}" placeholder="搜索姓名" placeholder-class="muted-placeholder" bindinput="onKeywordInput" />
      <view class="search-button" bind:tap="refresh">搜索</view>
      <view class="reset-button" bind:tap="resetFilters">重置</view>
    </view>
  </view>

  <view class="attendance-body">
    <scroll-view class="date-rail" scroll-y>
      <block wx:for="{{dateItems}}" wx:key="label">
        <view class="date-item {{activeDate === item.label ? 'active' : ''}}" data-value="{{item.value}}" bind:tap="setDate">
          {{item.label}}<text>({{item.count}})</text>
        </view>
      </block>
    </scroll-view>

    <view class="attendance-main">
      <view class="date-loading-mask" wx:if="{{dateLoading}}">
        <view class="date-loading-box">
          <view class="date-loading-spinner"></view>
          <text class="date-loading-text">加载中...</text>
        </view>
      </view>
      <view class="tab-row">
        <block wx:for="{{tabs}}" wx:key="*this">
          <view class="tab-item {{activeTab === item ? 'active' : ''}}" data-tab="{{item}}" bind:tap="setTab">{{item}}（{{item === '已出勤' ? stats.present : stats.absent}}）</view>
        </block>
      </view>
      <scroll-view class="worker-scroll" scroll-y>
        <block wx:for="{{filteredWorkers}}" wx:key="id">
          <view class="attendance-worker" data-id="{{item.id}}" bind:tap="openWorkerAttendance">
            <image class="worker-avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view class="worker-main">
              <view class="worker-name-row">
                <view class="worker-name">{{item.name}}</view>
                <view class="phone-action" data-name="电话" catchtap="showAction">电话</view>
              </view>
              <view class="worker-meta">{{item.workType}}</view>
              <view class="worker-phone">{{item.phone}}</view>
              <view class="time-row" wx:if="{{item.status === '已出勤'}}">
                <view class="time-pill in">签入 {{item.signIn}}</view>
                <view class="time-pill out">签出 {{item.signOut}}</view>
              </view>
              <view class="absent-note" wx:else>今日暂无进出场记录</view>
            </view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{!filteredWorkers.length}}">暂无匹配记录</view>
      </scroll-view>
    </view>
  </view>

  <view class="detail-mask" wx:if="{{detailVisible}}" catchtap="closeDetail"></view>
  <view class="detail-dialog {{detailVisible ? 'show' : ''}}">
    <view class="detail-header">
      <view>
        <view class="detail-title">{{currentDetail.name}}</view>
        <view class="detail-subtitle">{{currentDetail.teamName}} / {{currentDetail.companyName}}</view>
      </view>
      <view class="detail-close" bind:tap="closeDetail">×</view>
    </view>

    <view class="calendar-card">
      <view class="calendar-title-row">
        <view class="calendar-title">{{currentDetail.calendarMonth}}</view>
        <view class="calendar-summary">{{currentDetail.calendarLoading ? '加载中' : currentDetail.calendarAttendanceDays + '天出勤'}}</view>
      </view>
      <view class="calendar-week-row">
        <block wx:for="{{calendarWeekdays}}" wx:key="*this">
          <view>{{item}}</view>
        </block>
      </view>
      <view class="calendar-grid">
        <block wx:for="{{currentDetail.calendarDays}}" wx:key="key">
          <view class="calendar-day {{item.empty ? 'empty' : ''}} {{item.hasAttendance ? 'present' : ''}} {{item.isActive ? 'active' : ''}}">
            <text wx:if="{{!item.empty}}">{{item.day}}</text>
            <text wx:if="{{item.hasAttendance}}" class="day-dot"></text>
          </view>
        </block>
      </view>
      <view class="calendar-legend">
        <text class="legend-dot present"></text>
        <text>绿色日期表示当天有出勤记录</text>
      </view>
    </view>

    <view class="daily-title">{{activeDate}} 明细</view>
    <scroll-view class="detail-records" scroll-y>
      <block wx:if="{{currentDetail.records.length}}">
        <block wx:for="{{currentDetail.records}}" wx:key="id">
          <view class="detail-record">
            <view>
              <view class="record-direction">{{item.directionText}}</view>
              <view class="record-device">{{item.serial_number || item.equipment_id || '未填写设备'}}</view>
            </view>
            <view class="record-time">{{item.timeText}}</view>
          </view>
        </block>
      </block>
      <view class="empty-state" wx:else>当天暂无进出场明细</view>
    </scroll-view>
  </view>
</view>
