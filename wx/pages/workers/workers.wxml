<view class="workers-page">
  <block wx:if="{{!detailVisible}}">
    <view class="page-top">
      <view class="back-button" bind:tap="goBack">‹</view>
      <view class="page-title">在场人数（{{filteredWorkers.length}}）</view>
      <view class="top-action" data-name="批量退场" bind:tap="showAction">批量退场</view>
    </view>

    <view class="project-strip">
      <image class="project-bg" src="{{pageHeaderBg}}" mode="aspectFill" />
      <view class="project-label">项目名称</view>
      <view class="project-name">{{projectName}}</view>
    </view>

    <view class="search-card">
      <view class="search-box">
        <text class="search-dot"></text>
        <input class="search-input" value="{{keyword}}" placeholder="请输入姓名或手机号" placeholder-class="muted-placeholder" bindinput="onKeywordInput" />
      </view>
      <view class="search-button" bind:tap="refresh">搜索</view>
    </view>

    <view class="filter-card">
      <picker range="{{teamOptions}}" value="{{teamIndex}}" bindchange="onTeamFilterChange">
        <view class="filter-item">班组：<text>{{teamFilter}}</text></view>
      </picker>
      <view class="filter-divider"></view>
      <picker range="{{authOptions}}" value="{{authIndex}}" bindchange="onAuthFilterChange">
        <view class="filter-item">认证状态：<text>{{authFilter}}</text></view>
      </picker>
    </view>

    <view class="worker-list">
      <block wx:for="{{filteredWorkers}}" wx:key="id">
        <view class="worker-card" data-id="{{item.id}}" bind:tap="openWorkerDetail">
          <view class="auth-ribbon {{item.authStatus === '已认证' ? 'ok' : 'warn'}}">{{item.authStatus}}</view>
          <image class="worker-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view class="worker-info">
            <view class="worker-name">{{item.name}}</view>
            <view class="worker-line">{{item.genderText}} <text wx:if="{{item.age}}">· {{item.age}}岁</text> · {{item.statusText}}</view>
            <view class="worker-line">工种：{{item.workType}}　手机号：{{item.phone}}</view>
            <view class="worker-line">班组：{{item.team}}</view>
          </view>
          <view class="worker-actions">
            <view class="worker-action edit" data-id="{{item.id}}" catchtap="openEditWorker">编辑</view>
            <view class="worker-action issue" data-id="{{item.id}}" catchtap="retireWorker">退场</view>
            <view class="worker-action issue" data-name="下发" catchtap="showAction">下发</view>
          </view>
        </view>
      </block>
      <view class="empty-state" wx:if="{{!filteredWorkers.length}}">暂无匹配工人</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-top detail">
      <view class="back-button" bind:tap="goBack">‹</view>
      <view class="page-title">工人详情</view>
      <view class="top-action" bind:tap="saveWorker">编辑</view>
    </view>

    <view class="detail-card identity-card">
      <image class="detail-avatar" src="{{currentWorker.avatarUrl}}" mode="aspectFill" />
      <view class="identity-main">
        <view class="identity-name-row">
          <view class="identity-name">{{currentWorker.name}}</view>
          <view class="edit-mark" data-id="{{currentWorker.id}}" bind:tap="openEditWorker">编辑</view>
        </view>
        <view class="identity-sub">{{currentWorker.genderText}}　　{{currentWorker.age}}岁　　{{currentWorker.statusText}}</view>
      </view>
    </view>

    <view class="detail-card">
      <view class="detail-label">身份证号码</view>
      <view class="detail-value">{{currentWorker.idCard}}</view>
      <view class="detail-label">详细地址</view>
      <view class="detail-value">{{currentWorker.address}}</view>
      <view class="info-grid">
        <view>
          <view class="detail-label">籍贯</view>
          <view class="detail-value">{{currentWorker.nativePlace}}</view>
        </view>
        <view>
          <view class="detail-label">签证机关</view>
          <view class="detail-value">{{currentWorker.issuingAuthority}}</view>
        </view>
      </view>
      <view class="detail-label">有效期</view>
      <view class="detail-value">{{currentWorker.validPeriod}}</view>
    </view>

    <view class="info-list">
      <view class="info-row"><text>工种</text><text>{{currentWorker.workType}}</text></view>
      <view class="info-row"><text>工人类型</text><text>{{currentWorker.workerType}}</text></view>
      <view class="info-row"><text>班组</text><text>{{currentWorker.team}}</text></view>
      <view class="info-row"><text>参建单位</text><text>{{currentWorker.unit}}</text></view>
      <view class="info-row"><text>结算方式</text><text>{{currentWorker.settlement}}  ›</text></view>
      <view class="info-row"><text>默认单价（元）</text><text>{{currentWorker.unitPrice}} <text class="row-link" data-id="{{currentWorker.id}}" catchtap="openEditWorker">修改</text></text></view>
      <view class="info-row"><text>手机号</text><text>{{currentWorker.phone}} <text class="row-link" data-id="{{currentWorker.id}}" catchtap="openEditWorker">修改</text></text></view>
      <view class="info-row"><text>劳务合同</text><text class="row-link" data-name="劳务合同" bind:tap="showAction">签字</text></view>
      <view class="info-row"><text>退场</text><text class="row-link danger" data-id="{{currentWorker.id}}" bind:tap="retireWorker">办理退场</text></view>
      <view class="info-row"><text>删除</text><text class="row-link danger" data-id="{{currentWorker.id}}" bind:tap="deleteWorker">删除工人</text></view>
    </view>

    <view class="detail-card file-card">
      <view class="section-title">相关文件</view>
      <view class="file-label">身份证正面</view>
      <view class="id-preview">
        <view class="id-name">姓名　{{currentWorker.name}}</view>
        <view class="id-line">性别　{{currentWorker.genderText}}　民族　{{currentWorker.nation}}</view>
        <view class="id-line">住址　{{currentWorker.address}}</view>
        <view class="id-number">公民身份号码　{{currentWorker.idCard}}</view>
      </view>
      <view class="file-label">身份证反面</view>
      <view class="id-preview back">
        <view class="id-title">中华人民共和国 居民身份证</view>
        <view class="id-line">签发机关　{{currentWorker.issuingAuthority}}</view>
        <view class="id-line">有效期限　{{currentWorker.validPeriod}}</view>
      </view>
      <view class="file-label">人员签字</view>
      <view class="signature-button" data-name="人员签字" bind:tap="showAction">签字</view>
      <view class="signature-box">未签字</view>
    </view>
  </block>

  <view class="form-mask" wx:if="{{editVisible}}" catchtap="closeEdit"></view>
  <view class="form-sheet {{editVisible ? 'show' : ''}}">
    <view class="sheet-handle"></view>
    <view class="sheet-header">
      <view>
        <view class="sheet-title">编辑工人信息</view>
        <view class="sheet-subtitle">字段与 PC 项目工人表单一致</view>
      </view>
      <view class="sheet-close" bind:tap="closeEdit">×</view>
    </view>
    <scroll-view class="form-scroll" scroll-y>
      <block wx:for="{{formFields}}" wx:key="key">
        <view class="form-field {{item.wide ? 'wide' : ''}}">
          <view class="field-label">
            <text>{{item.label}}</text>
            <text class="required" wx:if="{{item.required}}">*</text>
          </view>
          <block wx:if="{{item.control === 'upload'}}">
            <view class="upload-field" data-key="{{item.key}}" bind:tap="chooseUpload">
              <view class="upload-main">{{item.uploadDisplay}}</view>
              <view class="upload-action">上传</view>
            </view>
          </block>
          <block wx:elif="{{item.control === 'select'}}">
            <picker range="{{item.options}}" range-key="label" value="{{item.optionIndex}}" data-key="{{item.key}}" bindchange="onPickerChange">
              <view class="select-value {{item.valueLabel ? '' : 'placeholder'}}">{{item.displayValue}}</view>
            </picker>
          </block>
          <block wx:elif="{{item.control === 'textarea'}}">
            <textarea class="native-textarea" value="{{item.value}}" placeholder="{{item.placeholder}}" placeholder-class="muted-placeholder" data-key="{{item.key}}" bindinput="onFormInput" />
          </block>
          <block wx:else>
            <input class="native-field" value="{{item.value}}" type="{{item.inputType}}" placeholder="{{item.placeholder}}" placeholder-class="muted-placeholder" data-key="{{item.key}}" bindinput="onFormInput" />
          </block>
        </view>
      </block>
    </scroll-view>
    <view class="sheet-footer">
      <view class="ghost-button" bind:tap="closeEdit">取消</view>
      <view class="primary-button {{saving ? 'disabled' : ''}}" bind:tap="submitEditWorker">{{saving ? '保存中...' : '保存'}}</view>
    </view>
  </view>
</view>
