.workers-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 88rpx 26rpx calc(46rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f7faf9 0%, #eef3f5 100%);
}

.page-top {
  display: grid;
  grid-template-columns: 100rpx 1fr 156rpx;
  align-items: center;
  min-height: 70rpx;
}

.back-button {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  color: #14282b;
  font-size: 50rpx;
  line-height: 54rpx;
  text-align: center;
}

.page-title {
  color: #18282b;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.top-action {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  min-width: 156rpx;
  min-height: 64rpx;
  padding: 0 8rpx;
  color: #0a9875;
  font-size: 25rpx;
  font-weight: 800;
  text-align: right;
}

.top-action-placeholder {
  width: 156rpx;
  height: 64rpx;
}

.project-strip {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 28rpx 26rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(42, 59, 78, 0.055);
}

.project-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.62;
}

.project-label,
.project-name {
  position: relative;
  z-index: 1;
}

.project-label {
  color: #6c7b80;
  font-size: 23rpx;
  font-weight: 700;
}

.project-name {
  margin-top: 8rpx;
  color: #243236;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.38;
}

.search-card,
.filter-card,
.worker-card,
.detail-card,
.info-list {
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 36rpx rgba(42, 59, 78, 0.052);
}

.search-card {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 16rpx;
}

.search-box {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f2f6f7;
}

.search-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 16rpx;
  border: 4rpx solid #98a8ac;
  border-radius: 999rpx;
}

.search-input {
  flex: 1;
  height: 68rpx;
  color: #223034;
  font-size: 25rpx;
}

.search-button {
  width: 112rpx;
  height: 72rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
  background: #0a9875;
}

.filter-card {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  margin-top: 18rpx;
  padding: 24rpx 10rpx;
}

.filter-item {
  color: #263438;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.filter-item text {
  color: #0a9875;
}

.filter-divider {
  height: 46rpx;
  background: #e0e8eb;
}

.worker-list {
  margin-top: 18rpx;
}

.worker-card {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-columns: 112rpx 1fr;
  column-gap: 22rpx;
  padding: 28rpx 24rpx 0;
}

.worker-card.selecting {
  grid-template-columns: 58rpx 112rpx 1fr;
  padding-bottom: 28rpx;
}

.worker-select {
  align-self: center;
  box-sizing: border-box;
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #bdc9cd;
  border-radius: 10rpx;
  background: #ffffff;
}

.worker-select.selected {
  display: flex;
  align-items: center;
  justify-content: center;
  border-color: #0a9875;
  background: #0a9875;
}

.worker-select-check {
  width: 16rpx;
  height: 9rpx;
  margin-top: -4rpx;
  border-bottom: 3rpx solid #ffffff;
  border-left: 3rpx solid #ffffff;
  transform: rotate(-45deg);
}

.worker-card + .worker-card {
  margin-top: 18rpx;
}

.auth-ribbon {
  position: absolute;
  top: 0;
  right: -48rpx;
  width: 170rpx;
  height: 44rpx;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 44rpx;
  text-align: center;
  transform: rotate(45deg);
}

.auth-ribbon.ok {
  background: #0a9875;
}

.auth-ribbon.warn {
  background: #d9a21b;
}

.worker-avatar,
.detail-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: #e6f1ee;
}

.worker-name {
  color: #1f2d30;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
}

.worker-line {
  margin-top: 10rpx;
  color: #627277;
  font-size: 24rpx;
  line-height: 1.26;
}

.worker-actions {
  grid-column: 1 / span 2;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 24rpx;
  border-top: 1rpx solid #e3ecef;
}

.worker-action {
  height: 72rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
}

.worker-action.edit {
  color: #0a9875;
  border-right: 1rpx solid #e3ecef;
}

.worker-action.issue {
  color: #c8870a;
}

.worker-action.reentry {
  color: #0a9875;
}

.batch-retire-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 12rpx 14rpx 12rpx 24rpx;
  border: 1rpx solid #dbe5e8;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(26, 44, 49, 0.18);
}

.batch-retire-count {
  color: #334348;
  font-size: 25rpx;
  font-weight: 700;
}

.batch-retire-button {
  min-width: 190rpx;
  height: 68rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 68rpx;
  text-align: center;
  background: #d85b4a;
}

.batch-retire-button.disabled {
  opacity: 0.48;
}

.row-link.danger {
  color: #d93026;
}

.empty-state {
  padding: 80rpx 0;
  color: #748187;
  font-size: 25rpx;
  text-align: center;
}

.load-more-state {
  padding: 30rpx 0 8rpx;
  color: #748187;
  font-size: 24rpx;
  text-align: center;
}

.detail-card {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.identity-name-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.identity-name {
  color: #1f2d30;
  font-size: 40rpx;
  font-weight: 800;
}

.edit-mark,
.row-link {
  color: #0a9875;
  font-size: 24rpx;
  font-weight: 800;
}

.identity-sub {
  margin-top: 18rpx;
  color: #5e6c72;
  font-size: 27rpx;
}

.detail-label {
  margin-top: 24rpx;
  color: #8a989d;
  font-size: 24rpx;
  line-height: 1.3;
}

.detail-label:first-child {
  margin-top: 0;
}

.detail-value {
  margin-top: 12rpx;
  color: #273437;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.46;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 28rpx;
}

.info-list {
  overflow: hidden;
  margin-top: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #edf2f3;
  color: #263438;
  font-size: 27rpx;
  font-weight: 700;
}

.info-row text:first-child {
  color: #7d8b90;
  font-weight: 500;
}

.section-title {
  color: #1f2d30;
  font-size: 30rpx;
  font-weight: 800;
}

.file-label {
  margin-top: 24rpx;
  color: #7d8b90;
  font-size: 24rpx;
}

.id-preview {
  margin-top: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #dfe8eb;
  border-radius: 18rpx;
  color: #2a393d;
  font-size: 24rpx;
  line-height: 1.55;
  background: linear-gradient(135deg, #fbf5ed 0%, #eef8f5 100%);
}

.id-preview.back {
  background: linear-gradient(135deg, #f7fbfa 0%, #eef4f6 100%);
}

.id-photo-preview {
  width: 100%;
  height: 260rpx;
  margin-top: 12rpx;
  border: 1rpx solid #dfe8eb;
  border-radius: 18rpx;
  background: #f6f8f9;
}

.id-title,
.id-name,
.id-number {
  font-weight: 800;
}

.signature-button {
  width: 128rpx;
  height: 72rpx;
  margin-top: 14rpx;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
  background: #0a9875;
}

.signature-entry {
  margin-top: 12rpx;
  height: 64rpx;
  border: 1rpx dashed #0a9875;
  border-radius: 14rpx;
  color: #0a9875;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
  background: #f2faf7;
}

.signature-box {
  margin-top: 20rpx;
  height: 136rpx;
  border: 1rpx solid #dfe8eb;
  border-radius: 18rpx;
  color: #a0aaae;
  font-size: 25rpx;
  line-height: 136rpx;
  text-align: center;
  background: #f6f8f9;
}

.signature-image {
  width: 100%;
  height: 160rpx;
  margin-top: 20rpx;
  border: 1rpx solid #dfe8eb;
  border-radius: 18rpx;
  background: #ffffff;
}

.muted-placeholder {
  color: #a2adb1;
}

.form-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  background: rgba(20, 35, 38, 0.42);
}

.form-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 31;
  padding: 16rpx 30rpx calc(34rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 54rpx rgba(32, 48, 51, 0.16);
  transform: translateY(110%);
  transition: transform 220ms ease;
}

.form-sheet.show {
  transform: translateY(0);
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #d9e5e7;
}

.sheet-header,
.sheet-footer,
.field-label,
.upload-field {
  display: flex;
  align-items: center;
}

.sheet-header,
.sheet-footer,
.upload-field {
  justify-content: space-between;
}

.sheet-title {
  color: #203033;
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-subtitle {
  margin-top: 8rpx;
  color: #7d8b90;
  font-size: 23rpx;
}

.sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  color: #748187;
  font-size: 42rpx;
  line-height: 54rpx;
  text-align: center;
  background: #edf3f4;
}

.form-scroll {
  max-height: 58vh;
  margin-top: 24rpx;
}

.form-field {
  margin-bottom: 20rpx;
}

.field-label {
  justify-content: flex-start;
  margin-bottom: 12rpx;
  color: #59666b;
  font-size: 23rpx;
  font-weight: 700;
}

.required {
  margin-left: 4rpx;
  color: #d65a44;
}

.native-field,
.select-value,
.native-textarea {
  width: 100%;
  border: 1rpx solid #dce6e8;
  border-radius: 16rpx;
  color: #233033;
  font-size: 26rpx;
  background: #ffffff;
}

.native-field,
.select-value {
  height: 76rpx;
  padding: 0 22rpx;
  line-height: 74rpx;
}

.native-place-row {
  display: flex;
  gap: 14rpx;
}

.native-place-picker {
  flex: 1;
  min-width: 0;
}

.native-textarea {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  line-height: 1.45;
}

.placeholder {
  color: #a4afb4;
}

.sheet-footer {
  gap: 18rpx;
  padding-top: 16rpx;
}

.ghost-button,
.primary-button {
  flex: 1;
  height: 78rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 78rpx;
  text-align: center;
}

.ghost-button {
  color: #59666b;
  background: #eaf1f2;
}

.primary-button {
  color: #ffffff;
  background: #0a9875;
}

.primary-button.disabled {
  opacity: 0.58;
}

.reentry-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: rgba(20, 35, 38, 0.42);
}

.reentry-dialog {
  position: fixed;
  top: 50%;
  right: 40rpx;
  left: 40rpx;
  z-index: 41;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 72rpx rgba(20, 35, 38, 0.2);
  transform: translateY(-50%);
}

.reentry-title {
  color: #203033;
  font-size: 34rpx;
  font-weight: 800;
}

.reentry-name {
  margin-top: 10rpx;
  color: #718087;
  font-size: 25rpx;
}

.reentry-label {
  margin-top: 28rpx;
  color: #59666b;
  font-size: 23rpx;
  font-weight: 700;
}

.reentry-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dce6e8;
  border-radius: 16rpx;
  color: #233033;
  font-size: 26rpx;
}

.reentry-picker text {
  color: #8a989d;
  font-size: 34rpx;
}

.reentry-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.reentry-cancel,
.reentry-submit {
  flex: 1;
  height: 78rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 78rpx;
  text-align: center;
}

.reentry-cancel {
  color: #59666b;
  background: #eaf1f2;
}

.reentry-submit {
  color: #ffffff;
  background: #0a9875;
}

.reentry-submit.disabled {
  opacity: 0.58;
}

.upload-field {
  min-height: 76rpx;
  padding: 0 18rpx 0 22rpx;
  border: 1rpx solid #dce6e8;
  border-radius: 16rpx;
  background: #ffffff;
}

.upload-main {
  min-width: 0;
  color: #233033;
  font-size: 25rpx;
}

.upload-action {
  flex: 0 0 auto;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 52rpx;
  background: #0a9875;
}

.upload-list {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}

.upload-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  min-height: 72rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #e0eaec;
  border-radius: 14rpx;
  background: #f8fbfb;
}

.upload-thumb,
.upload-file-icon {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border-radius: 10rpx;
}

.upload-thumb {
  background: #edf4f2;
}

.upload-file-icon {
  color: #0a8066;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-align: center;
  background: #e5f3ef;
}

.upload-file-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #233033;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-view-action {
  flex: 0 0 auto;
  color: #0a8066;
  font-size: 23rpx;
  font-weight: 800;
}
