<view class="login-page">
  <image class="login-bg" src="{{loginIllustration}}" mode="aspectFill" />
  <view class="login-bg-fade"></view>

  <view class="login-content">
    <view class="brand-block">
      <view class="brand-mark">山</view>
      <view class="brand-name">山淮筑</view>
      <view class="brand-subtitle">实名考勤管理平台</view>
    </view>

    <view class="login-card">
      <view class="field-group">
        <view class="field-label">账号</view>
        <view class="native-input-wrap">
          <view class="input-icon" aria-hidden="true">
            <image class="input-icon-image" src="{{accountIcon}}" mode="aspectFit" />
          </view>
          <input
            class="native-input"
            value="{{account}}"
            placeholder="请输入手机号或用户名"
            placeholder-class="input-placeholder"
            bindinput="onAccountChange"
          />
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">密码</view>
        <view class="native-input-wrap">
          <view class="input-icon" aria-hidden="true">
            <image class="input-icon-image" src="{{lockIcon}}" mode="aspectFit" />
          </view>
          <input
            class="native-input"
            value="{{password}}"
            password="{{!passwordVisible}}"
            placeholder="请输入密码"
            placeholder-class="input-placeholder"
            bindinput="onPasswordChange"
          />
          <view class="input-action" bind:tap="togglePasswordVisibility" aria-label="{{passwordVisible ? '隐藏密码' : '显示密码'}}">
            <image class="input-icon-image" src="{{passwordVisible ? eyeOffIcon : eyeIcon}}" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="form-row">
        <view class="remember-row" bind:tap="toggleRemember">
          <view class="checkbox {{rememberAccount ? 'checkbox-active' : ''}}">
            <view wx:if="{{rememberAccount}}" class="checkbox-check"></view>
          </view>
          <text>记住账号</text>
        </view>
        <view class="forgot-link" bind:tap="forgotPassword">忘记密码</view>
      </view>

      <button class="login-button-native" loading="{{loading}}" disabled="{{loading}}" bind:tap="submitLogin">登录</button>
    </view>

    <view class="agreement-block">
      <view class="agreement-check-wrap" bind:tap="toggleAgreement">
        <view class="agreement-checkbox {{agreedToTerms ? 'agreement-checkbox-active' : ''}}">
          <view wx:if="{{agreedToTerms}}" class="agreement-checkmark"></view>
        </view>
        <view class="agreement-text-wrap">
          <text class="agreement-text">我已阅读并同意</text>
          <text class="agreement-link" catchtap="openAgreement">《用户服务协议》</text>
          <text class="agreement-text">和</text>
          <text class="agreement-link" catchtap="openPrivacy">《隐私政策》</text>
        </view>
      </view>
    </view>

    <view class="support-footer">宁波山淮科技有限公司 技术支持</view>
  </view>
</view>
