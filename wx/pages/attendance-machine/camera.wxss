.camera-page {
  min-height: 100vh;
  padding: 0 30rpx 60rpx;
  background:
    radial-gradient(circle at 18% 0%, rgba(217, 244, 239, 0.9) 0, rgba(217, 244, 239, 0) 230rpx),
    linear-gradient(180deg, #f4f8f8 0%, #edf3f5 100%);
  box-sizing: border-box;
}

.camera-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  color: #102427;
  font-size: 48rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 12rpx 28rpx rgba(42, 59, 78, 0.06);
}

.camera-title-wrap {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.camera-title {
  color: #102427;
  font-size: 34rpx;
  font-weight: 600;
}

.camera-subtitle {
  margin-top: 4rpx;
  color: #718086;
  font-size: 22rpx;
}

.camera-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.camera-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f6b5d;
  font-size: 26rpx;
  box-shadow: 0 10rpx 26rpx rgba(42, 59, 78, 0.08);
}

.camera-switch-icon {
  font-size: 28rpx;
}

.camera-position-tag {
  color: #8a979c;
  font-size: 22rpx;
}

.camera-panel {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  height: 720rpx;
  border-radius: 30rpx;
  background: #0c1a18;
  box-shadow: 0 20rpx 50rpx rgba(12, 26, 24, 0.25);
}

.camera-view {
  width: 100%;
  height: 100%;
}

.scan-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 420rpx;
  height: 520rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.scan-corner {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-color: rgba(21, 147, 127, 0.95);
  border-style: solid;
}

.scan-corner.tl { top: 0; left: 0; border-width: 6rpx 0 0 6rpx; border-top-left-radius: 24rpx; }
.scan-corner.tr { top: 0; right: 0; border-width: 6rpx 6rpx 0 0; border-top-right-radius: 24rpx; }
.scan-corner.bl { bottom: 0; left: 0; border-width: 0 0 6rpx 6rpx; border-bottom-left-radius: 24rpx; }
.scan-corner.br { bottom: 0; right: 0; border-width: 0 6rpx 6rpx 0; border-bottom-right-radius: 24rpx; }

.camera-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(12, 26, 24, 0.45);
}

.camera-mask-text {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #0f6b5d;
  font-size: 26rpx;
  font-weight: 600;
}

.camera-blocked {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  padding: 0 60rpx;
  text-align: center;
}

.camera-blocked-title {
  font-size: 32rpx;
  font-weight: 600;
}

.camera-blocked-note {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  line-height: 1.6;
}

.camera-blocked-btn {
  margin-top: 30rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: #15937f;
  font-size: 26rpx;
}

.capture-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
}

.result-banner {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 22rpx 28rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.result-banner.ok {
  background: rgba(15, 107, 93, 0.1);
  border: 2rpx solid rgba(15, 107, 93, 0.35);
}

.result-banner.fail {
  background: rgba(200, 74, 60, 0.08);
  border: 2rpx solid rgba(200, 74, 60, 0.3);
}

.result-title {
  color: #102427;
  font-size: 28rpx;
  font-weight: 600;
}

.result-note {
  margin-top: 8rpx;
  color: #718086;
  font-size: 24rpx;
}

.capture-button {
  width: 320rpx;
  height: 96rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0f6b5d 0%, #15937f 100%);
  box-shadow: 0 16rpx 40rpx rgba(15, 107, 93, 0.35);
  line-height: normal;
}

.capture-button::after {
  border: none;
}

.capture-button.disabled {
  opacity: 0.6;
}

.capture-button-inner {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}

.capture-hint {
  margin-top: 18rpx;
  color: #8a979c;
  font-size: 22rpx;
}

.today-section {
  margin-top: 36rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 40rpx rgba(42, 59, 78, 0.06);
}

.today-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.today-title {
  color: #102427;
  font-size: 30rpx;
  font-weight: 600;
}

.today-count {
  color: #0f6b5d;
  font-size: 24rpx;
}

.today-empty {
  padding: 44rpx 0;
  color: #9aa7ac;
  font-size: 24rpx;
  text-align: center;
}

.today-list {
  margin-top: 10rpx;
}

.today-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f4f4;
}

.today-item:last-child {
  border-bottom: none;
}

.today-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e6efee;
}

.today-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0f6b5d;
  font-size: 28rpx;
  font-weight: 600;
}

.today-main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.today-name {
  color: #102427;
  font-size: 28rpx;
  font-weight: 600;
}

.today-time {
  margin-top: 6rpx;
  color: #8a979c;
  font-size: 22rpx;
}

.today-direction {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.today-direction.in {
  background: rgba(15, 107, 93, 0.1);
  color: #0f6b5d;
}

.today-direction.out {
  background: rgba(176, 122, 40, 0.12);
  color: #a06a1f;
}

/* 隐私授权弹窗 */
.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(12, 26, 24, 0.55);
}

.privacy-modal {
  width: 600rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(12, 26, 24, 0.25);
}

.privacy-title {
  color: #102427;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.privacy-content {
  margin-top: 24rpx;
  color: #42545a;
  font-size: 26rpx;
  line-height: 1.7;
}

.privacy-link {
  color: #0f6b5d;
  font-weight: 600;
}

.privacy-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.privacy-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: normal;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn-reject {
  background: #f0f4f4;
  color: #718086;
}

.privacy-btn-agree {
  background: linear-gradient(135deg, #0f6b5d 0%, #15937f 100%);
  color: #ffffff;
  font-weight: 600;
}
