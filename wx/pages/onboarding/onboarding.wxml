<view class="onboarding-page">
  <view class="topbar">
    <view class="back-button" bind:tap="goBack">‹</view>
    <view class="topbar-title">实名入职</view>
    <view class="topbar-spacer"></view>
  </view>

  <view class="intro-panel">
    <image class="intro-bg" src="{{pageHeaderBg}}" mode="aspectFill" />
    <view class="intro-kicker">人员入场</view>
    <view class="intro-title">实名入职登记</view>
    <view class="intro-copy">{{projectName}}</view>
  </view>

  <view class="onboarding-form">
    <block wx:for="{{formSections}}" wx:key="name">
      <view class="form-section">
        <view class="section-title">{{item.name}}</view>
        <block wx:for="{{item.fields}}" wx:key="key" wx:for-item="field">
          <view class="field {{field.wide ? 'wide' : ''}}">
            <view class="field-label">{{field.label}} <text wx:if="{{field.required}}">*</text></view>
            <block wx:if="{{field.control === 'upload'}}">
              <view class="upload-field" data-key="{{field.key}}" bind:tap="chooseUpload">
                <view class="upload-main">{{field.uploadDisplay}}</view>
                <view class="upload-action">{{field.uploadActionText}}</view>
              </view>
              <view class="upload-list" wx:if="{{field.uploadItems.length}}">
                <view
                  class="upload-item"
                  wx:for="{{field.uploadItems}}"
                  wx:for-item="file"
                  wx:key="url"
                  data-url="{{file.url}}"
                  data-name="{{file.name}}"
                  data-is-image="{{file.isImage}}"
                  bind:tap="previewUpload"
                >
                  <image wx:if="{{file.isImage}}" class="upload-thumb" src="{{file.url}}" mode="aspectFill" />
                  <view wx:else class="upload-file-icon">文</view>
                  <view class="upload-file-name">{{file.name}}</view>
                  <view class="upload-view-action">查看</view>
                </view>
              </view>
            </block>
            <block wx:elif="{{field.control === 'select'}}">
              <picker range="{{field.options}}" range-key="label" value="{{field.optionIndex}}" data-key="{{field.key}}" bindchange="onPickerChange">
                <view class="select-value {{field.valueLabel ? '' : 'placeholder'}}">{{field.displayValue}}</view>
              </picker>
            </block>
            <block wx:elif="{{field.control === 'textarea'}}">
              <textarea class="field-textarea" value="{{field.value}}" data-key="{{field.key}}" placeholder="{{field.placeholder}}" placeholder-class="muted-placeholder" bindinput="onFormInput" />
            </block>
            <block wx:elif="{{field.valueType === 'date'}}">
              <picker mode="date" value="{{field.value}}" data-key="{{field.key}}" bindchange="onFormInput">
                <view class="select-value {{field.value ? '' : 'placeholder'}}">{{field.dateDisplay}}</view>
              </picker>
            </block>
            <block wx:else>
              <input class="field-input" type="{{field.inputType}}" value="{{field.value}}" data-key="{{field.key}}" placeholder="{{field.placeholder}}" placeholder-class="muted-placeholder" bindinput="onFormInput" />
            </block>
          </view>
        </block>
      </view>
    </block>

    <view class="submit-notice" wx:if="{{submitNotice}}">{{submitNotice}}</view>
    <view class="submit-button {{saving ? 'disabled' : ''}}" bind:tap="submitOnboarding">{{saving ? '提交中...' : '提交实名入职'}}</view>
  </view>

  <view class="phone-mask" wx:if="{{phoneModalVisible}}"></view>
  <view class="phone-modal {{phoneModalVisible ? 'show' : ''}}">
    <view class="phone-modal-title">先查询手机号</view>
    <view class="phone-modal-copy">输入手机号后，系统会先查找当前项目已有实名资料；查到则更新，查不到则新增入职。</view>
    <view class="phone-input-wrap">
      <input class="phone-input" type="number" value="{{phoneLookupValue}}" focus="{{phoneModalVisible}}" placeholder="请输入手机号" placeholder-class="muted-placeholder" bindinput="onPhoneLookupInput" />
    </view>
    <view class="phone-match-tip" wx:if="{{lookupMatchedPreview}}">检测到已有人员，确认后自动带出资料。</view>
    <view class="phone-modal-actions">
      <view class="modal-ghost" bind:tap="goBack">返回</view>
      <view class="modal-primary" bind:tap="confirmPhoneLookup">确认并填写</view>
    </view>
  </view>
</view>
